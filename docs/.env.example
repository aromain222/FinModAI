# --- Core Settings ---
# Maximum age of volatile data (e.g., quotes) in minutes before it's considered stale.
DATA_STALENESS_MAX_MIN=30

# Set to 'true' to allow the system to use Playwright scraping as a last resort.
ALLOW_SCRAPE_FALLBACK=true

# Set to 'true' to enable the daily FMP bulk CSV download.
ENABLE_FMP_BULK=true

# --- Provider API Keys (add your keys here) ---
# Required for EDGAR provider. SEC uses this to contact you if your script is disruptive.
SEC_UA_EMAIL=Kingromain23@gmail.com

