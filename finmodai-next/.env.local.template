# CapitalBase Environment Variables
# Copy this file to .env.local and fill in your actual keys
# DO NOT commit .env.local to git!

# ========================================
# REQUIRED - Supabase Auth
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://thvbhrzavzjnwecwhbgj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ========================================
# REQUIRED - OpenAI (for Chat/Scenario Engine)
# ========================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-5.4
NEXT_PUBLIC_ROOT_DOMAIN=capital-base.com
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE

# ========================================
# OPTIONAL - Enhanced Features
# ========================================
USE_LANGCHAIN_AGENT=false
PERIGON_API_KEY=YOUR_PERIGON_API_KEY_HERE
BENZINGA_API_KEY=YOUR_BENZINGA_API_KEY_HERE
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE
EODHD_API=YOUR_EODHD_API_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
PEXELS_API_KEY=YOUR_PEXELS_API_KEY_HERE
MACRO_EVENTS_ADMIN_TOKEN=YOUR_LOCAL_ADMIN_TOKEN_HERE
FMP_API_KEY=YOUR_FMP_API_KEY_HERE

# ========================================
# Dexter — Financial Datasets (financialdatasets.ai)
# ========================================
# Powers Dexter panel: income statements, cash flows, ratios, SEC filings, insider trades
# Get your key at https://financialdatasets.ai
FINANCIAL_DATASETS_API_KEY=YOUR_FINANCIAL_DATASETS_API_KEY_HERE

# ========================================
# TimesFM / Python Backend
# ========================================
# URL of the FastAPI backend serving TimesFM forecasts and TradingAgents analysis.
# Local: http://localhost:8082  |  Production: your deployed backend URL
PYTHON_BACKEND_URL=http://localhost:8082

# X (Twitter) API — OAuth 1.0a user context (all four required for posting)
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
