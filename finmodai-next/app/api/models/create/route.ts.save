import { randomUUID } from 'node:crypto';
import { cookies } from 'next/headers';
import { createRouteHandlerClient } from '@supabase/auth-helpers-nextjs';
import { z } from 'zod';
import { normalizeModelRequest, type CreateModelRequest } from '@/types/modelContracts';

const MODEL_FALLBACK_TICKERS: Record<string, string> = {
  merger: 'MERGER',
  operating: 'OPERATING',
};

const MODEL_INSERT_COLUMNS = [
  'user_id',
  'model_type',
  'type',
  'ticker',
  'status',
  'scenario',
  'scenario_adjustment_notes',
  'scenario_summary_notes',
  'company_name',
] as const;
type ModelInsertColumn = (typeof MODEL_INSERT_COLUMNS)[number];

const createModelSchema = z
  .object({
    ticker: z.string().min(1, 'Ticker is required').optional(),
    modelType: z.string().min(1, 'Model type is required').optional(),
    model_type: z.string().min(1, 'Model type is required').optional(),
    scenario: z.string().optional(),
    scenario_adjustment_notes: z.string().optional().nullable(),
    scenarioAdjustmentNotes: z.string().optional().nullable(),
    scenario_summary_notes: z.string().optional().nullable(),
    scenarioSummaryNotes: z.string().optional().nullable(),
    assumptions: z.record(z.any()).optional(),
    companyName: z.string().optional().nullable(),
    company_name: z.string().optional().nullable(),
  })
  .passthrough();

function buildModelInsertPayload(
  base: Partial<Record<ModelInsertColumn, string>>
) {
  const payload: Record<ModelInsertColumn, string> = {} as Record<ModelInsertColumn, string>;
  const invalidKeys = Object.keys(base).filter(
    (key) => !MODEL_INSERT_COLUMNS.includes(key as ModelInsertColumn)
  );

  if (invalidKeys.length > 0 && process.env.NODE_ENV !== 'production') {
    console.warn('[CREATE_MODEL][INVALID_PAYLOAD_KEYS]', invalidKeys);
  }

  for (const column of MODEL_INSERT_COLUMNS) {
    if (base[column] !== undefined) {
      payload[column] = base[column]!;
    }
  }

  return payload;
}

export async function POST(req: Request) {
  const traceId = randomUUID();
  // TODO: DB currently has both `type` and `model_type`. Once downstream references are audited,
  //       consolidate on a single canonical column to avoid future drift.

  try {
    const supabase = createRouteHandlerClient({ cookies });
    const {
      data: { session },
      error: sessionErr,
    } = await supabase.auth.getSession();

    if (sessionErr) {
      console.error('[CREATE_MODEL][SESSION]', { traceId, error: sessionErr });
      return Response.json(
        {
          error: 'Unauthorized',
          details: sessionErr.message,
          code: sessionErr.code ?? 'SESSION_ERROR',
          traceId,
        },
        { status: 401 }
      );
    }
   ION]', { traceId });
      return Response.json(
        {
          error: 'Unauthorized',
          details: 'Authentication required

    let body: CreateModelRequest;
    try {
      const json = await req.json();
      const parseResult = createModelSchema.safeParse(json);
      if (!parseResult.success) {
        const message = parseResult.error.errors.map((err) => err.message).join('; ');
        return Response.json(
          {
            error: 'Invalid request body',
            details: message,
            code: 'INVALID_BODY',
            traceId,
          },
          { status: 400 }
        );
      }
      body = parseResult.data;
    } catch (parseErr) {
      console.error('[CREATE_MODEL][INVALID_JSON]', { traceId, error: parseErr });
      return Response.json(
        {
          error: 'Invalid request body',
          details: 'Expected valid JSON payload.',
          code: 'INVALID_JSON',
          traceId,
        },
        { status: 400 }
      );
    }

    const userId = session.user.id;

    const normalized = normalizeModelRequest(body);

    const rawModelType = normalized.modelType || (typeof (body as any)?.model_type === 'string' ? (body as any).model_type.trim() : '');
    const modelType = typeof rawModelType === 'string' ? rawModelType.trim() : '';
    if (!modelType) {
      console.error('[CREATE_MODEL][MISSING_MODEL_TYPE]', { traceId });
      return Response.json(
        {
          error: 'Model type is required',
          details: 'Include modelType in the request body.',
          code: 'MISSING_MODEL_TYPE',
          traceId,
        },
        { status: 400 }
      );
    }

    const normalizedModelType = modelType as string;

    const normalizedTicker =
      typeof normalized.ticker === 'string' && normalized.ticker.length > 0
        ? normalized.ticker
        : null;

    const requiresTicker = !['merger', 'operating'].includes(normalizedModelType);
    if (requiresTicker && !normalizedTicker) {
      console.error('[CREATE_MODEL][MISSING_TICKER]', { traceId });
      return Response.json(
        {
          error: 'Ticker is required',
          details: 'Provide a valid ticker symbol.',
          code: 'MISSING_TICKER',
          traceId,
        },
        { status: 400 }
      );
    }

    const fallbackTickerKey = normalizedModelType.toLowerCase();
    const ticker =
      normalizedTicker ||
      MODEL_FALLBACK_TICKERS[fallbackTickerKey] ||
      'UNKNOWN';

    const normalizedScenario = normalized.scenario || 'BASE';
    const normalizedScenarioAdjustmentNotes =
      normalized.scenario_adjustment_notes ??
      body.scenario_adjustment_notes ??
      body.scenarioAdjustmentNotes ??
      '';
    const normalizedScenarioSummaryNotes =
      normalized.scenario_summary_notes ??
      body.scenario_summary_notes ??
      body.scenarioSummaryNotes ??
      '';

    const rawAssumptions =
      normalized.assumptions && typeof normalized.assumptions === 'object'
        ? normalized.assumptions
        : {};

    const payload = buildModelInsertPayload({
      user_id: userId,
      model_type: normalizedModelType,
      type: normalizedModelType,
      ticker,
      status: 'created',
      scenario: normalizedScenario,
      scenario_adjustment_notes: normalizedScenarioAdjustmentNotes,
      scenario_summary_notes: normalizedScenarioSummaryNotes,
      company_name: normalized.companyName ?? null,
    });

    const defaultUnits = {
      currency: 'USD',
      scale: 'MILLIONS',
      shares: 'MILLIONS',
      rates: 'DECIMAL',
    };

    const insertData: Record<string, any> = {
      ...payload,
      assumptions: rawAssumptions,
      units: defaultUnits,
    };

    console.log('[CREATE_MODEL][INSERT_PAYLOAD_KEYS]', {
      traceId,
      keys: Object.keys(insertData),
    });

    const { data, error } = await supabase
      .from('models')
      .insert(insertData)
      .select('id, ticker, model_type, type, status, scenario')
      .single();

    if (error) {
      console.error('[CREATE_MODEL][INSERT_ERROR]', { traceId, error });
      return Response.json(
        {
          error: 'Failed to create model record',
          details: error.message,
          code: error.code,
          traceId,
        },
        { status: 500 }
      );
    }

    if (!data?.id) {
      console.error('[CREATE_MODEL][NO_ID_RETURNED]', { traceId });
      return Response.json(
        {
          error: 'Failed to create model record',
          details: 'Insert succeeded but no ID returned.',
          code: 'INSERT_NO_ID',
          traceId,
        },
        { status: 500 }
      );
    }

    console.log('[CREATE_MODEL][INSERTED]', { traceId, inserted: data });
    const responsePayload: CreateModelResponse = {
      modelId: data.id,
      id: data.id,
      traceId,
    };

    return Response.json(responsePayload, { status: 200 });
  } catch (error) {
    const message = error instanceof Error ? error.message : 'Unknown error';
    console.error('[CREATE_MODEL][UNEXPECTED]', { traceId, error });
    return Response.json(
      {
        error: 'Failed to create model record',
        details: message,
        code: 'UNEXPECTED_ERROR',
        traceId,
      },
      { status: 500 }
    );
  }
}
