{
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/rank/cron",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/pm/monitor-cron",
      "schedule": "45 13 * * 1-5"
    },
    {
      "path": "/api/pm/monitor-close-cron",
      "schedule": "15 20 * * 1-5"
    },
    {
      "path": "/api/pm/news-alert-cron",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/pm/brief?type=daily",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/pm/brief?type=weekly",
      "schedule": "30 21 * * 5"
    },
    {
      "path": "/api/pm/brief?type=monthly",
      "schedule": "0 22 1 * *"
    },
    {
      "path": "/api/execution/auto-trade-cron",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/pm/trading-agent/cron",
      "schedule": "30 13-19 * * 1-5"
    },
    {
      "path": "/api/pm/market-brief-cron?slot=open",
      "schedule": "0 10 * * 1-5"
    },
    {
      "path": "/api/pm/market-brief-cron?slot=mid",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/pm/market-brief-cron?slot=noon",
      "schedule": "0 16 * * 1-5"
    },
    {
      "path": "/api/pm/market-brief-cron?slot=afternoon",
      "schedule": "0 18 * * 1-5"
    },
    {
      "path": "/api/pm/market-brief-cron?slot=close",
      "schedule": "0 20 * * 1-5"
    }
  ]
}
