{
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/rank/cron",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/pm/monitor-cron",
      "schedule": "45 13 * * 1-5"
    },
    {
      "path": "/api/pm/monitor-cron",
      "schedule": "15 20 * * 1-5"
    },
    {
      "path": "/api/pm/news-alert-cron",
      "schedule": "0 12,14,16,18,20 * * 1-5"
    },
    {
      "path": "/api/pm/brief?type=daily",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/pm/brief?type=weekly",
      "schedule": "30 21 * * 5"
    },
    {
      "path": "/api/pm/brief?type=monthly",
      "schedule": "0 22 1 * *"
    },
    {
      "path": "/api/execution/auto-trade-cron",
      "schedule": "0 14 * * 1-5"
    }
  ]
}
