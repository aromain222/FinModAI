# Premium Configuration for FinModAI
# High-quality AI enhancement for professional use

# AI Enhancement Settings
USE_AI_DATA_ENHANCEMENT=true
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600  # 1 hour (balance between freshness and cost)
AI_MIN_QUALITY_THRESHOLD=70  # Only enhance when quality < 70
AI_MAX_DAILY_QUERIES=1000

# AI Component Settings
USE_AI_FOR_VALIDATION=true
USE_AI_FOR_GAP_FILLING=true
USE_AI_FOR_PEER_COMPARISON=true

# Cost per query
AI_COST_PER_QUERY=0.05

# Provider Settings
POLYGON_API_KEY=your_polygon_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# Data Quality Settings
DATA_MODE=production
DATA_STALENESS_MAX_MIN=30
REQUIRE_MIN_FUND_YEARS=3

# AI Chatbot Settings
AI_CHATBOT_ENABLED=true
AI_CHATBOT_MODEL=claude-4-sonnet-20250514
AI_CHATBOT_MAX_TOKENS=4000
AI_CHATBOT_TEMPERATURE=0.7

# Investment Advice Settings
INVESTMENT_ADVICE_ENABLED=true
RISK_TOLERANCE=moderate
INVESTMENT_HORIZON=long_term

